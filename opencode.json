// v1.0.0 (2026-08-04) opencode.json
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "SUMMARY.md"],
  "skills": {
    "paths": [".opencode/skills"],
    "auto": ["rust-encoding", "rust-single-source", "rust-api-first", "rust-file-sizes", "rust-autosave", "rust-localization", "rust-versioning", "rust-naming", "rust-ui-testing"]
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git fetch*": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git rev-list*": "allow",
          "git remote*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git -C * fetch*": "allow",
          "git -C * status*": "allow",
          "git -C * log*": "allow",
          "git -C * rev-list*": "allow",
          "git -C * remote*": "allow",
          "git -C * diff*": "allow",
          "git -C * show*": "allow",
          "git -C * branch*": "allow",
          "git config --get*": "allow",
          "git config --list*": "allow",
          "git config --global --get*": "allow",
          "git config --global --list*": "allow",
          "rg*": "allow",
          "pwsh --version*": "allow",
          "uname*": "allow",
          "Test-Path*": "allow",
          "Get-ChildItem*": "allow",
          "Get-Content*": "allow",
          "Select-String*": "allow"
        }
      }
    }
  },
  "lsp": true,
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "git push*": "ask",
      "*": "allow",
      "rm *": "ask",
      "del *": "ask",
      "Remove-Item*": "ask"
    }
  }
}
